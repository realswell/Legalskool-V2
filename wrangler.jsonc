{
  "name": "legalskool-v2",
  "main": "worker/index.js",
  "build": {
    "command": "if [ -d node_modules/typescript ]; then npm run build; else echo 'Using the committed dist folder'; fi"
  },
  "compatibility_date": "2026-11-14",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/pay/*", "/notes", "/notes/*", "/aivakeel", "/aivakeel/*", "/campus", "/campus/*", "/admin", "/admin/*"]
  },
  "previews": {}
}
